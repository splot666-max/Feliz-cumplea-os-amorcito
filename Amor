  <!-- =========================
       CARTAS
  ========================== -->

  <section id="cartas">

    <div class="container">

      <div class="section-title">

        <h2>
          Unas palabras para ti
        </h2>

        <p>
          Hay algunas cosas que quiero decirte...
        </p>

      </div>


      <div class="cards">


        <!-- CARTA 1 -->

        <article
          class="card"
          data-letter="love"
        >

          <div
            class="card-image"
            style="background-image:url('img/lo-que-amo.jpg')"
          ></div>

          <div class="card-content">

            <h3>
              Lo que amo de ti
            </h3>

            <span>
              Abre esta pequeña carta ♡
            </span>

          </div>

        </article>


        <!-- CARTA 2 -->

        <article
          class="card"
          data-letter="promesa"
        >

          <div
            class="card-image"
            style="background-image:url('img/una-promesa.jpg')"
          ></div>

          <div class="card-content">

            <h3>
              Una promesa
            </h3>

