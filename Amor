            </span>

          </div>

        </article>


      </div>

    </div>

  </section>


  <!-- =========================
       FOOTER
  ========================== -->

  <footer>

    <p>
      Gracias por existir, por ser tú,
      por hacer mi vida más bonita
      y por todos esos momentos que hemos compartido.
    </p>

    <p class="forever">
      ♡ Hoy, mañana y siempre... ♡
    </p>

  </footer>


  <!-- =========================
       MODAL DE LAS CARTAS
  ========================== -->

  <div
    class="modal"
    id="modal"
  >

    <button
      class="letter-close"
      id="closeModal"
      aria-label="Cerrar"
    >
      ×
    </button>


    <div class="envelope-scene">

      <div
        class="envelope"
        id="loveEnvelope"
        role="button"
        tabindex="0"
        aria-label="Abrir carta"
      >

        <div class="envelope-back"></div>


        <div class="envelope-paper">

          <h3>
            Para mi princesa Jolly ♡
          </h3>

          <p id="loveLetterText"></p>

        </div>


        <div class="envelope-flap"></div>

        <div class="envelope-front"></div>

        <div class="envelope-seal">
          ♥
        </div>

        <div class="envelope-hint">
          Toca el sobre para abrir tu carta ♡
        </div>

      </div>

    </div>

  </div>


  <!-- =========================
       JAVASCRIPT
  ========================== -->

