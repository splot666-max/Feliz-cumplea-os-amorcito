`,

      sorpresa: `
Quiero que sepas que todo esto lo hice pensando en ti, no necesitaba una fecha especial para recordarte cuánto te amo, pero hoy quería hacer algo que fuera solamente para ti amorcito.

Si algún día dudas de lo mucho que significas para mí, vuelve a esta pequeña página y recuerda que lo hice pensando en ti y solamente para ti Jolly. 🖤❤️
`

    };


    /* ==========================================
       ELEMENTOS
    ========================================== */

    const modal =
      document.getElementById("modal");

    const envelope =
      document.getElementById("loveEnvelope");

    const loveLetterText =
      document.getElementById("loveLetterText");

    const closeModal =
      document.getElementById("closeModal");


    /* ==========================================
       ABRIR CARTA
    ========================================== */

    function openEnvelope(
      text,
      autoOpen = false
    ) {

      loveLetterText.textContent = text;

      envelope.classList.remove("opened");

      modal.classList.add("show");

      document.body.style.overflow = "hidden";


      if (autoOpen) {

        setTimeout(() => {

          envelope.classList.add("opened");

        }, 450);

      }

    }


    /* ==========================================
       CERRAR CARTA
    ========================================== */

    function closeLetter() {

      modal.classList.remove("show");

      envelope.classList.remove("opened");

      document.body.style.overflow = "";

    }


    /* ==========================================
       CLICK EN LAS TARJETAS
    ========================================== */

    document
      .querySelectorAll(".card")
      .forEach(card => {

        card.addEventListener(
          "click",
          () => {

            const type =
              card.dataset.letter;


            if (type === "love") {

              openEnvelope(
                LOVE_LETTER,
                false
              );

            }


            if (type === "promesa") {

              openEnvelope(
                OTHER_LETTERS.promesa,
                true
              );

            }


            if (type === "sorpresa") {

              openEnvelope(
                OTHER_LETTERS.sorpresa,
                true
              );

            }

          }

        );

      });


    /* ==========================================
       ABRIR SOBRE MANUALMENTE
    ========================================== */

    envelope.addEventListener(
      "click",
      () => {

        envelope.classList.toggle("opened");

      }
    );


    /* ==========================================
       TECLADO
    ========================================== */

    envelope.addEventListener(
      "keydown",
      event => {

        if (
          event.key === "Enter" ||
          event.key === " "
        ) {

          event.preventDefault();

          envelope.classList.toggle(
            "opened"
          );

        }

      }
    );


    /* ==========================================
       BOTÓN CERRAR
    ========================================== */

    closeModal.addEventListener(
      "click",
      closeLetter
    );


    /* ==========================================
       ESC PARA CERRAR
    ========================================== */

    document.addEventListener(
      "keydown",
      event => {

        if (
          event.key === "Escape" &&
          modal.classList.contains("show")
        ) {

          closeLetter();

        }

      }
    );


    /* ==========================================
       CLICK FUERA DEL SOBRE
    ========================================== */

    modal.addEventListener(
      "click",
      event => {

        if (event.target === modal) {

          closeLetter();

        }

      }
    );


    /* ==========================================
       PÉTALOS CAYENDO
    ========================================== */

    function createPetal() {

      const petal =
        document.createElement("div");

      petal.className = "petal";


      const flowers = [
        "🌹",
        "🌸"
      ];


      petal.textContent =
        flowers[
          Math.floor(
            Math.random() *
            flowers.length
          )
        ];


      petal.style.left =
        Math.random() * 100 + "vw";


      petal.style.fontSize =
        (14 + Math.random() * 13) + "px";


      petal.style.animationDuration =
        (6 + Math.random() * 7) + "s";


      petal.style.opacity =
        0.4 + Math.random() * 0.6;


      document.body.appendChild(petal);


      setTimeout(
        () => {
          petal.remove();
        },
        14000
      );

    }


    /* ==========================================
       CREAR PÉTALOS CADA CIERTO TIEMPO
    ========================================== */

    setInterval(
      createPetal,
      650
    );


    /* ==========================================
       ALGUNOS PÉTALOS INICIALES
    ========================================== */

    for (
      let i = 0;
      i < 8;
      i++
    ) {

      setTimeout(
        createPetal,
        i * 300
      );

    }

  </script>

</body>
</html>
